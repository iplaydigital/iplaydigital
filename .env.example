# ══════════════════════════════════════════════════════════════
#  iPlay Workspace — ตัวอย่างไฟล์ตั้งค่า
#  คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env && chmod 600 .env
#  หมายเหตุ: ค่า env ถูกอ่านตอนแอปบูต → แก้แล้วต้อง restart เสมอ
# ══════════════════════════════════════════════════════════════

# ── MariaDB (ตั้งค่าแล้วระบบใช้ฐานข้อมูลจริงแทน demo store) ──
# ทั้งสอง user อยู่เครื่องเดียวกับเว็บ → ใช้ 127.0.0.1
# เลือกได้ 2 แบบ (ระบบรองรับทั้งคู่) ──
# แบบที่ 1 (แนะนำ): DB_USER=iplay
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iplay
DB_PASSWORD=__ใส่รหัสผ่านที่นี่__
DB_NAME=agency_os

# แบบที่ 2: DB_USER=agency_os
# DB_USER=agency_os
# DB_PASSWORD=__ใส่รหัสผ่านที่นี่__
# DB_NAME=agency_os

# ห้าม commit รหัสผ่านจริงลง git — ไฟล์นี้เป็นตัวอย่างเท่านั้น (.env อยู่ใน .gitignore)

# ⚠️ ถ้ารหัสมี $ ! # ให้เขียนไฟล์นี้ด้วย heredoc เพื่อไม่ให้ bash ตีความ:
#   cat > .env <<'ENVEOF'
#   DB_USER=iplay
#   DB_PASSWORD=__รหัสผ่านจริงของทีม__
#   DB_NAME=agency_os
#   ENVEOF

# ถ้าตั้ง 1 = ห้าม fallback (คืน 503 พร้อมสาเหตุแทนการสลับไปข้อมูลสำรอง)
# DB_REQUIRED=1

# ── ตัวเลือก ──
# ที่อยู่จอ LED Playwall Park Silom
NEXT_PUBLIC_LED_URL=https://playwall-parksilom.pages.dev/
# Google Drive โฟลเดอร์กลางของทีม
NEXT_PUBLIC_DRIVE_FOLDER=https://drive.google.com/drive/folders/1iPlayDigitalWorkspace
# MCP server ของ Google Drive (ถ้าใช้) เช่น http://127.0.0.1:8787
# GOOGLE_MCP_URL=
# LLM gateway (ถ้าใช้) — ถ้าไม่ตั้ง ระบบใช้ context engine ในตัว
# AI_GATEWAY_URL=
# AI_GATEWAY_KEY=
# AI_MODEL=claude-sonnet-4-5

# หมายเหตุ: ไฟล์ example นี้ไม่มีรหัสผ่านจริง — ขอจากผู้ดูแลระบบแล้วใส่ใน .env บนเซิร์ฟเวอร์
